---
import { CutCornerButton } from "../../components/CutCornerButton";
import DefaultLayout from "../../layouts/Default.astro";
import { HeaderSection } from "../../sections/Header";
// import { getCollection } from 'astro:content';

// const posts = (await getCollection('blog')).sort(
// 	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
// );
---

<DefaultLayout>
  <HeaderSection client:load />
  <section class="py-60 relative">
    <div></div>
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <p class="uppercase font-extrabold text-center text-zinc-500 tracking-wider">
          Latest Post
        </p>
        <h1 class="font-heading font-black text-7xl text-center mt-4">
          Regulatory Challenges Facing Blockchain
        </h1>
        <p class="text-center text-2xl mt-6 text-zinc-400 max-w-xl mx-auto">
          Understanding the Regulatory lanscape surrounding blockchain and what
          it means for the future of this technology.
        </p>
        <div class="flex justify-center mt-10">
          <CutCornerButton>Read More</CutCornerButton>
        </div>
      </div>
    </div>
  </section>
  <div>{/* Blog Posts */}</div>
</DefaultLayout>
