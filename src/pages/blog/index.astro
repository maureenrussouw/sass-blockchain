---
import { Card } from "../../components/Card";
import { CutCornerButton } from "../../components/CutCornerButton";
import { Hexagon } from "../../components/Hexagon";
import { Tag } from "../../components/Tag";
import DefaultLayout from "../../layouts/Default.astro";
import { HeaderSection } from "../../sections/Header";
import { getCollection } from "astro:content";
import { getPostColorFromCategory } from "../../utils/postUtils";
import { twMerge } from "tailwind-merge";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPost = posts[0];
---

<DefaultLayout>
  <HeaderSection client:load />
  <section class="py-60 relative overflow-x-clip">
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
      <Hexagon size={800} client:load duration={30} />
    </div>
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
      <Hexagon size={1200} client:load duration={50} reverse />
    </div>
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <p class="uppercase font-extrabold text-center text-zinc-500 tracking-wider">
          Latest Post
        </p>
        <h1 class="font-heading font-black text-7xl text-center mt-4">
          {latestPost.data.title}
        </h1>
        <p class="text-center text-2xl mt-6 text-zinc-400 max-w-xl mx-auto">
          {latestPost.data.description}
        </p>
        <div class="flex justify-center mt-10">
          <a href=`/blog/${latestPost.id}`>
            <CutCornerButton>Read More</CutCornerButton>
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="pb-[1000px]">
    <div class="container">
      <div class="grid grid-cols-2 gap-8">
        <div class="flex flex-col gap-12">
          {posts.map(
            ({ id, data: { category, title, description } }, postIndex) => (
              <a
                href={`/blog/${id}`}
                class={twMerge(postIndex % 2 === 0 ? "" : "hidden")}
              >
                <Card
                  buttonText="Read More"
                  color={getPostColorFromCategory(category)}
                >
                  <Tag color={getPostColorFromCategory(category)}>
                    {category}
                  </Tag>
                  <h2 class="font-heading font-font-black text-3xl mt-4">
                    {title}
                  </h2>
                  <p class="text-lg mt-6 text-zinc-400">{description}</p>
                </Card>
              </a>
            ),
          )}
        </div>
        <div>
          <div class="flex flex-col gap-12">
            {posts.map(
              ({ id, data: { category, title, description } }, postIndex) => (
                <a
                  href={`/blog/${id}`}
                  class={twMerge(postIndex % 2 === 0 ? "hidden" : "")}
                >
                  <Card
                    buttonText="Read More"
                    color={getPostColorFromCategory(category)}
                  >
                    <Tag color={getPostColorFromCategory(category)}>
                      {category}
                    </Tag>
                    <h2 class="font-heading font-font-black text-3xl mt-4">
                      {title}
                    </h2>
                    <p class="text-lg mt-6 text-zinc-400">{description}</p>
                  </Card>
                </a>
              ),
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</DefaultLayout>
