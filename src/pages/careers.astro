---
import { getCollection } from "astro:content";
import InteriorContent from "../components/InteriorContent.astro";
import InteriorHero from "../components/InteriorHero.astro";
import DefaultLayout from "../layouts/Default.astro";
import { CareerPositions } from "../sections/CareerPositions";

const positions = await getCollection("positions");
const careerPositions = positions.map(
  ({ data: { title, type, description, category, remote } }) => ({
    title,
    type,
    description,
    category,
    remote,
  }),
);
---

<DefaultLayout>
  <InteriorHero>
    <p class="uppercase font-extrabold text-center text-zinc-500 tracking-wider">
      Join the team
    </p>
    <h1 class="font-heading font-black text-5xl md:text-6xl lg:text-7xl text-center mt-4">
      We Are hiring
    </h1>
    <p class="text-center text-xl md:text-2xl mt-6 max-w-xl mx-auto text-zinc-400">
      We are always looking for talented individuals passionate about building
      blockchain products that make a difference.
    </p>
  </InteriorHero>
  <InteriorContent>
    <CareerPositions client:load positions={careerPositions} />
  </InteriorContent>
</DefaultLayout>
